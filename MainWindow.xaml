<Window x:Class="SmtcMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmtcMonitor"
        Title="SMTC 原始数据监视器"
        Width="720"
        Height="800"
        MinWidth="500"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1C"
        Foreground="#F2F2F2"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="MutedBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#6C6C6C" />
    <SolidColorBrush x:Key="CardBrush" Color="#252525" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E5684F" />

    <Style x:Key="ToolButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#2C2C2C" />
      <Setter Property="Foreground" Value="#E8E8E8" />
      <Setter Property="BorderBrush" Value="#454545" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#383838" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#414141" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolToggle" TargetType="{x:Type ToggleButton}">
      <Setter Property="Background" Value="#2C2C2C" />
      <Setter Property="Foreground" Value="#E8E8E8" />
      <Setter Property="BorderBrush" Value="#454545" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#383838" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#414141" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#274A34" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#5FD08A" />
                <Setter Property="Foreground" Value="#7CE0A3" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RowLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Width" Value="148" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Padding" Value="0,0,10,3" />
    </Style>

    <Style x:Key="RowValue" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="#F2F2F2" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Padding" Value="0,0,0,3" />
    </Style>

    <DataTemplate x:Key="SessionCardTemplate" DataType="{x:Type local:SessionCardViewModel}">
      <Border Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14,11,14,9"
              Margin="0,0,0,10">
        <StackPanel>
          <DockPanel Margin="0,0,0,9">
            <Border DockPanel.Dock="Right"
                    CornerRadius="99"
                    Padding="9,2"
                    Background="{Binding StatusBackground}"
                    VerticalAlignment="Center"
                    Margin="10,0,0,0">
              <TextBlock Text="{Binding StatusText}"
                         FontSize="10.5"
                         FontWeight="SemiBold"
                         FontFamily="Cascadia Mono, Consolas"
                         Foreground="{Binding StatusForeground}" />
            </Border>
            <TextBlock Text="{Binding SourceAppUserModelId}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SourceAppUserModelId}"
                       VerticalAlignment="Center" />
          </DockPanel>

          <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,9" />

          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="Title:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding TitleText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="Artist:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding ArtistText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="Subtitle:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding SubtitleText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="AlbumTitle:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding AlbumTitleText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="AlbumArtist:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding AlbumArtistText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="TrackNumber:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding TrackText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="Genres:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding GenresText}" />
          </DockPanel>

          <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,5,0,9" />

          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="PlaybackStatus:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding PlaybackStatusText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="PlaybackRate:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding PlaybackRateText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="PlaybackType:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding PlaybackTypeText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="AutoRepeatMode:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding AutoRepeatModeText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="IsShuffleActive:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding ShuffleText}" />
          </DockPanel>

          <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,5,0,9" />

          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="Position:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding PositionText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="StartTime:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding StartTimeText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="EndTime:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding EndTimeText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="MinSeekTime:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding MinSeekTimeText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="MaxSeekTime:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding MaxSeekTimeText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="LastUpdatedTime:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding LastUpdatedText}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Style="{StaticResource RowLabel}" DockPanel.Dock="Left" Text="CapturedAt:" />
            <TextBlock Style="{StaticResource RowValue}" Text="{Binding CapturedAtText}" />
          </DockPanel>

          <TextBlock Text="{Binding ErrorText}"
                     Foreground="{StaticResource ErrorBrush}"
                     FontSize="11"
                     FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                     TextWrapping="Wrap"
                     Visibility="{Binding ErrorVisibility}"
                     Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top"
            Background="#222222"
            BorderBrush="#333333"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <DockPanel>
        <TextBlock x:Name="SamplingStatus"
                   DockPanel.Dock="Right"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource SubtleBrush}"
                   FontSize="11" />
        <StackPanel Orientation="Horizontal">
          <Button x:Name="PauseButton"
                  Style="{StaticResource ToolButton}"
                  Click="OnPauseClicked">暂停</Button>
          <Button Style="{StaticResource ToolButton}"
                  Margin="8,0,0,0"
                  Click="OnCopyClicked">复制</Button>
          <ToggleButton x:Name="TopmostToggle"
                        Style="{StaticResource ToolToggle}"
                        Margin="8,0,0,0"
                        Checked="OnTopmostToggled"
                        Unchecked="OnTopmostToggled">置顶</ToggleButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="#222222"
            BorderBrush="#333333"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <TextBlock x:Name="FooterStatus"
                 Foreground="{StaticResource SubtleBrush}"
                 FontSize="11"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="12,10,12,10">
        <Border x:Name="EmptyState" Visibility="Collapsed">
          <StackPanel Margin="0,80,0,40">
            <TextBlock Text="未发现 SMTC 会话"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyStateHint"
                       Text="任意播放器注册系统媒体控制后，这里会按 SMTC 上报顺序原样显示每个会话。"
                       FontSize="11.5"
                       Foreground="{StaticResource SubtleBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="420"
                       Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <ItemsControl x:Name="SessionList" ItemTemplate="{StaticResource SessionCardTemplate}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
